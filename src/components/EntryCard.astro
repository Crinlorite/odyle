---
import type { Lang } from '../i18n/langs';
import { t } from '../i18n/strings';
import { TOPICS } from '../lib/topics';
import { fmtDate, langOf, slugOf, type Entry } from '../lib/entries';
import Seal from './Seal.astro';
interface Props { entry: Entry; lang: Lang }
const { entry, lang } = Astro.props;
const d = entry.data;
const s = t(lang);
const foot = d.status === 'duda' ? s.unverified : [fmtDate(d.verifiedAt!, lang), d.where ? `${s.level} ${d.where.level}` : null, d.where?.zone].filter(Boolean).join(' · ');
const el = langOf(entry); // si no está traducida, la ficha es la española
---
<article class="card" data-status={d.status}>
  <div class="row"><Seal status={d.status} lang={lang} /><span class="topic">{TOPICS[lang][d.topic].name}</span>{el !== lang && <span class="enes">{s.inSpanish}</span>}</div>
  <h3><a href={`/${el}/cuaderno/${slugOf(entry)}/`} hreflang={el !== lang ? el : undefined} lang={el !== lang ? el : undefined}>{d.title}</a></h3>
  <p lang={el !== lang ? el : undefined}>{d.description}</p>
  <p class="data">{foot}</p>
</article>
