---
import { existsSync } from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LANGS, type Lang } from '../../../i18n/langs';
import { t } from '../../../i18n/strings';
import { fmtDate } from '../../../lib/entries';
export async function getStaticPaths() {
  const all = await getCollection('notes');
  return all.filter((n) => (LANGS as readonly string[]).includes(n.id.split('/')[0])).map((note) => ({ params: { lang: note.id.split('/')[0], slug: note.id.split('/')[1] }, props: { note } }));
}
const lang = Astro.params.lang as Lang;
const { note } = Astro.props;
const d = note.data;
const s = t(lang);
const ogImage = `/og/${lang}/apunte-${note.id.split('/')[1]}.jpg`;
if (!existsSync(`public${ogImage}`)) throw new Error(`${note.id}: falta ${ogImage}; lanza «npm run og»`);
const { Content } = await render(note);
---
<Base lang={lang} title={d.title} description={d.description} section="apuntes" ogImage={ogImage}>
  <article>
    <header class="page-head">
      <div class="row"><span class="seal seal--apunte">{s.noteSeal}</span><a class="topic" href={`/${lang}/apuntes/`}>{s.notesTitle}</a></div>
      <h1>{d.title}</h1>
      <dl class="ficha">
        <div><dt>{s.noteUpdated}</dt><dd>{fmtDate(d.updated, lang)}</dd></div>
        <div><dt>{s.noteBasis}</dt><dd>{d.basis}</dd></div>
      </dl>
    </header>
    <p class="warn">Esto es un apunte mío, no una entrada del cuaderno. No lo he comprobado en el cliente global: es lo que sigo mientras juego, sacado de las fuentes de abajo. Lo que vaya confirmando pasará al cuaderno.</p>
    {d.glossary.length > 0 && (
      <p class="glos" id="glos" hidden>
        <button type="button" id="glos-btn" aria-pressed="false">Ver los nombres en español</button>
        <span>Las skills salen con el nombre del juego en inglés. El botón las cambia a como aparecen con el juego en español.</span>
      </p>
    )}
    <div class="plain"><div class="prose"><Content /></div></div>
    {d.glossary.length > 0 && (
      <script is:inline define:vars={{ pairs: d.glossary }}>
        (function () {
          var box = document.getElementById('glos'), btn = document.getElementById('glos-btn');
          if (!box || !btn) return;
          var art = box.closest('article');
          var esc = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/['\u2019]/g, "['\u2019]"); };
          var key = function (s) { return s.replace(/\u2019/g, "'").toLowerCase(); };
          var sorted = pairs.slice().sort(function (a, b) { return b.en.length - a.en.length; });
          var map = {}; sorted.forEach(function (p) { map[key(p.en)] = p.es; });
          var src = '(^|[^A-Za-z\u00C0-\u00FF])(' + sorted.map(function (p) { return esc(p.en); }).join('|') + ')(?![A-Za-z\u00C0-\u00FF])';
          var re = new RegExp(src, 'g'), probe = new RegExp(src);
          var nodes = [], w = document.createTreeWalker(art, NodeFilter.SHOW_TEXT);
          while (w.nextNode()) {
            var n = w.currentNode, pa = n.parentElement;
            if (!pa || pa.closest('.aside, script, style, #glos')) continue;
            if (probe.test(n.nodeValue)) nodes.push({ n: n, en: n.nodeValue, es: n.nodeValue.replace(re, function (m, pre, term) { return pre + (map[key(term)] || term); }) });
          }
          function set(es, save) {
            nodes.forEach(function (o) { o.n.nodeValue = es ? o.es : o.en; });
            btn.setAttribute('aria-pressed', es ? 'true' : 'false');
            btn.textContent = es ? 'Ver los nombres en inglés' : 'Ver los nombres en español';
            if (save) { try { localStorage.setItem('odyle-nombres', es ? 'es' : 'en'); } catch (e) {} }
          }
          var q = new URLSearchParams(location.search).get('nombres'), saved = null;
          try { saved = localStorage.getItem('odyle-nombres'); } catch (e) {}
          box.hidden = false;
          set(q ? q === 'es' : saved === 'es', false);
          btn.addEventListener('click', function () { set(btn.getAttribute('aria-pressed') !== 'true', true); });
        })();
      </script>
    )}
    <div class="aside">
      <h2>{s.sources}</h2>
      <ul>{d.sources.map((src) => <li><a href={src.url} rel="noopener">{src.title}</a> <span class="lang">[{src.lang}]</span></li>)}</ul>
      <p class="signed">— {s.signed}</p>
    </div>
  </article>
</Base>
