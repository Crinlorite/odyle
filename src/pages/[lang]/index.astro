---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { LANGS, type Lang } from '../../i18n/langs';
import { t } from '../../i18n/strings';
import { entriesFor, counts, fmtDate } from '../../lib/entries';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t(lang);
const list = await entriesFor(lang);
const c = counts(list);
---
<Base lang={lang} title="odyle" description={`${s.heroA} ${s.heroB}. ${s.lead}`}>
  <section class="hero">
    <p class="kicker">{s.tagline}</p>
    <h1>{s.heroA} <span class="hl">{s.heroB}</span>.</h1>
    <p class="lead">{s.lead}</p>
    <p class="data">{s.summary(c.total, c.ok, c.open)} · {s.lastOn}: {fmtDate(list[0].data.updated, lang)}</p>
    <p class="note">{s.marginNote}</p>
  </section>
  <section>
    <div class="sec-title"><h2>{s.latest}</h2><a href={`/${lang}/cuaderno/`}>{s.allEntries}</a></div>
    <ul class="cards">{list.slice(0, 6).map((e) => <li><EntryCard entry={e} lang={lang} /></li>)}</ul>
  </section>
</Base>
